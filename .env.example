DATABASE_URL=postgresql://jewelry_app:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/jewelry_ecommerce
PAYLOAD_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
INVENTORY_RESERVATION_MINUTES=15

# Rate limiting (in-process, per server instance)
RATE_LIMIT_ENABLED=true
# Number of reverse proxies in front of the app that append to X-Forwarded-For.
TRUSTED_PROXY_HOPS=1

# First administrator. Anonymous first-admin signup is allowed only outside production unless
# ALLOW_ADMIN_BOOTSTRAP=true. In production create the first admin with:
#   ADMIN_EMAIL=you@example.com ADMIN_NAME="Your Name" ADMIN_PASSWORD='...' pnpm create-admin
ALLOW_ADMIN_BOOTSTRAP=false

# Background jobs (expire unpaid holds, reconcile lost payments), every 60 seconds.
MAINTENANCE_JOBS_ENABLED=true

# End-to-end tests (pnpm test:e2e) must run against a disposable database whose name ends in
# _test. Create it once as a PostgreSQL superuser:
#   CREATE DATABASE jewelry_ecommerce_test OWNER jewelry_app;
# then run `pnpm migrate` against it. Setting E2E_ALLOW_SHARED_DB=true instead lets the suite run
# against the development database using only rows it creates and removes itself.
# TEST_DATABASE_URL=postgresql://jewelry_app:PASSWORD@127.0.0.1:5432/jewelry_ecommerce_test

# Optional: AI description drafts for staff. Leave GROQ_API_KEY empty to turn the button off.
# AI features use LangChain, so the provider is a setting. Only "groq" is installed today.
AI_PROVIDER=groq
# AI_MODEL overrides the default model (GROQ_MODEL is still read for Groq).
AI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
